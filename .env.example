# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Claude API key for the "Answer" feature. It lives ONLY on the Vercel server (server/),
# never inside the iPhone app. Paste it after the = with no quotes or spaces.
ANTHROPIC_API_KEY=

# Shared secret the iPhone app sends to the DocSnap server so strangers can't use it.
# Generated by scripts/setup_server_secrets.sh — don't edit by hand.
DOCSNAP_APP_TOKEN=
